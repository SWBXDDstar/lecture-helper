<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- WPF and WinForms both ship implicit usings whose types collide (Application, Point, Color, Pen...). -->
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>LectureHelper.Shared</AssemblyName>
    <RootNamespace>LectureHelper</RootNamespace>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

</Project>
