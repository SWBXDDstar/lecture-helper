<Window x:Class="ScreenCapture.Views.CaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:LectureHelper.Views;assembly=LectureHelper.Shared"
        Title="ScreenCapture"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="False"
        WindowStartupLocation="Manual"
        Background="Black"
        Cursor="Cross"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Malgun Gothic">

    <Grid x:Name="Root">
        <Canvas x:Name="Surface" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top">

            <Image x:Name="Shot" Canvas.Left="0" Canvas.Top="0"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>

            <v:AnnotationLayer x:Name="Layer" Canvas.Left="0" Canvas.Top="0"/>

            <Path x:Name="Mask" Fill="#8C000000"/>

            <Rectangle x:Name="HoverHint" Visibility="Collapsed" IsHitTestVisible="False"
                       Stroke="#FF4DA3FF" StrokeThickness="2" StrokeDashArray="4 3" Fill="#1A4DA3FF"/>

            <Rectangle x:Name="SelectionBorder" Visibility="Collapsed" IsHitTestVisible="False"
                       Stroke="#FF4DA3FF" StrokeThickness="1"/>

            <Canvas x:Name="Handles" IsHitTestVisible="False"/>

            <Border x:Name="SizeLabel" Visibility="Collapsed" IsHitTestVisible="False"
                    Background="#D9101317" CornerRadius="3" Padding="7,3">
                <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
            </Border>

            <Border x:Name="Magnifier" Visibility="Collapsed" IsHitTestVisible="False"
                    Background="#E6101317" CornerRadius="4" Padding="4">
                <StackPanel>
                    <Border BorderBrush="#FF4DA3FF" BorderThickness="1" Width="132" Height="132" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="MagImage" Stretch="Fill"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            <Line X1="0" Y1="65" X2="130" Y2="65" Stroke="#B34DA3FF" StrokeThickness="1"/>
                            <Line X1="65" Y1="0" X2="65" Y2="130" Stroke="#B34DA3FF" StrokeThickness="1"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="MagInfo" Foreground="#FFDDE3EA" FontSize="11" Margin="1,4,1,0"
                               FontFamily="Consolas"/>
                    <TextBlock Foreground="#FF8B95A1" FontSize="10" Margin="1,2,1,0"
                               Text="C: 색상 코드 복사"/>
                </StackPanel>
            </Border>

            <Border x:Name="HintBar" Background="#D9101317" CornerRadius="6" Padding="12,7"
                    IsHitTestVisible="False" Visibility="Collapsed">
                <TextBlock Foreground="#FFDDE3EA" FontSize="12" LineHeight="19">
                    <Run Text="드래그" FontWeight="Bold"/><Run Text=" 영역 선택   "/>
                    <Run Text="클릭" FontWeight="Bold"/><Run Text=" 창 전체 선택   "/>
                    <Run Text="Alt+드래그" FontWeight="Bold"/><Run Text=" 영역 이동   "/>
                    <Run Text="핸들" FontWeight="Bold"/><Run Text=" 크기 조절"/>
                    <LineBreak/>
                    <Run Text="드래그" FontWeight="Bold"/><Run Text=" 펜   "/>
                    <Run Text="Ctrl" FontWeight="Bold"/><Run Text=" 네모   "/>
                    <Run Text="Tab" FontWeight="Bold"/><Run Text=" 동그라미   "/>
                    <Run Text="Shift" FontWeight="Bold"/><Run Text=" 직선   "/>
                    <Run Text="Ctrl+Shift" FontWeight="Bold"/><Run Text=" 화살표   "/>
                    <Run Text="휠" FontWeight="Bold"/><Run Text=" 두께"/>
                    <LineBreak/>
                    <Run Text="R G B Y P O" FontWeight="Bold"/><Run Text=" 색상   "/>
                    <Run Text="H" FontWeight="Bold"/><Run Text=" 형광펜   "/>
                    <Run Text="M" FontWeight="Bold"/><Run Text=" 모자이크   "/>
                    <Run Text="N" FontWeight="Bold"/><Run Text=" 숫자   "/>
                    <Run Text="T" FontWeight="Bold"/><Run Text=" 텍스트   "/>
                    <Run Text="F1" FontWeight="Bold"/><Run Text=" 이 안내   "/>
                    <Run Text="Esc / X" FontWeight="Bold"/><Run Text=" 취소"/>
                </TextBlock>
            </Border>

            <TextBox x:Name="TextEditor" Visibility="Collapsed"
                     Background="#40000000" BorderBrush="#FF4DA3FF" BorderThickness="1"
                     Padding="2,0" MinWidth="40" AcceptsReturn="True" CaretBrush="White"
                     FontFamily="Malgun Gothic" FontWeight="Bold" Cursor="IBeam"/>

            <Border x:Name="Toolbar" Visibility="Collapsed" Cursor="Arrow"
                    Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="4">
                <StackPanel Orientation="Horizontal">

                    <ToggleButton x:Name="BtnPen" Style="{StaticResource ToolToggle}" ToolTip="펜 (그냥 드래그)">
                        <Path Style="{StaticResource ToolIconPath}" Data="M4,20 L4,15.5 L15,4.5 L19.5,9 L8.5,20 Z"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnHighlighter" Style="{StaticResource ToolToggle}" ToolTip="형광펜 (H)">
                        <Path Style="{StaticResource ToolIconPath}" Data="M5,20 H19 M7,16.5 L14.5,5 L18.5,9 L11,16.5 Z"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnLine" Style="{StaticResource ToolToggle}" ToolTip="직선 (Shift+드래그)">
                        <Path Style="{StaticResource ToolIconPath}" Data="M4.5,19.5 L19.5,4.5"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnArrow" Style="{StaticResource ToolToggle}" ToolTip="화살표 (Ctrl+Shift+드래그)">
                        <Path Style="{StaticResource ToolIconPath}" Data="M4.5,19.5 L19.5,4.5 M19.5,4.5 L12.5,5.5 M19.5,4.5 L18.5,12.5"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnRect" Style="{StaticResource ToolToggle}" ToolTip="사각형 (Ctrl+드래그)">
                        <Path Style="{StaticResource ToolIconPath}" Data="M4,6 H20 V18 H4 Z"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnEllipse" Style="{StaticResource ToolToggle}" ToolTip="타원 (Tab+드래그)">
                        <Path Style="{StaticResource ToolIconPath}" Data="M12,5.5 C16.7,5.5 20.5,8.4 20.5,12 C20.5,15.6 16.7,18.5 12,18.5 C7.3,18.5 3.5,15.6 3.5,12 C3.5,8.4 7.3,5.5 12,5.5 Z"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnMosaic" Style="{StaticResource ToolToggle}" ToolTip="모자이크 (M) · 휠로 세기 조절">
                        <Path Style="{StaticResource ToolIconPath}" StrokeThickness="0"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              Data="M4,4 H10 V10 H4 Z M14,4 H20 V10 H14 Z M4,14 H10 V20 H4 Z M14,14 H20 V20 H14 Z"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnBlur" Style="{StaticResource ToolToggle}" ToolTip="흐리게 (Shift+M) · 휠로 세기 조절">
                        <Path Style="{StaticResource ToolIconPath}" Data="M12,3.5 C16.7,3.5 20.5,7.3 20.5,12 C20.5,16.7 16.7,20.5 12,20.5 C7.3,20.5 3.5,16.7 3.5,12 C3.5,7.3 7.3,3.5 12,3.5 Z M12,8 C14.2,8 16,9.8 16,12 C16,14.2 14.2,16 12,16 C9.8,16 8,14.2 8,12 C8,9.8 9.8,8 12,8 Z"/>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnNumber" Style="{StaticResource ToolToggle}" ToolTip="숫자 마커 (N)">
                        <Grid Width="18" Height="18">
                            <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.7"/>
                            <TextBlock Text="1" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                        </Grid>
                    </ToggleButton>
                    <ToggleButton x:Name="BtnText" Style="{StaticResource ToolToggle}" ToolTip="텍스트 (T)">
                        <Path Style="{StaticResource ToolIconPath}" Data="M5,6.5 V4.5 H19 V6.5 M12,4.5 V19.5 M9,19.5 H15"/>
                    </ToggleButton>

                    <Rectangle Width="1" Margin="5,4" Fill="#FF454B55"/>

                    <Button x:Name="BtnColor" Style="{StaticResource ToolButton}" ToolTip="색상">
                        <Border x:Name="ColorSwatch" Width="18" Height="18" CornerRadius="3"
                                BorderBrush="#FF9AA3AE" BorderThickness="1" Background="Red"/>
                    </Button>

                    <Border Background="#FF23262C" CornerRadius="4" Padding="7,0" Margin="2,3" VerticalAlignment="Stretch">
                        <!-- Fixed width: a changing readout would shift every button under the cursor. -->
                        <TextBlock x:Name="SizeReadout" Foreground="#FFDDE3EA" FontSize="11"
                                   VerticalAlignment="Center" Width="52" TextAlignment="Center"/>
                    </Border>

                    <Button x:Name="BtnUndo" Style="{StaticResource ToolButton}" ToolTip="실행 취소 (Ctrl+Z)">
                        <Path Style="{StaticResource ToolIconPath}" Data="M9,7 L4,12 L9,17 M4,12 H14.5 A4.5,4.5 0 0 1 14.5,21"/>
                    </Button>
                    <Button x:Name="BtnRedo" Style="{StaticResource ToolButton}" ToolTip="다시 실행 (Ctrl+Y)">
                        <Path Style="{StaticResource ToolIconPath}" Data="M15,7 L20,12 L15,17 M20,12 H9.5 A4.5,4.5 0 0 0 9.5,21"/>
                    </Button>

                    <Rectangle Width="1" Margin="5,4" Fill="#FF454B55"/>

                    <Button x:Name="BtnPin" Style="{StaticResource ActionButton}" Content="고정" ToolTip="화면에 고정 (Ctrl+D)"/>
                    <Button x:Name="BtnCopy" Style="{StaticResource ActionButton}" Content="복사" ToolTip="클립보드로 복사 (Ctrl+C)"/>
                    <Button x:Name="BtnSave" Style="{StaticResource ActionButton}" Content="저장" ToolTip="PNG로 저장 (Ctrl+S)"/>
                    <Button x:Name="BtnClose" Style="{StaticResource ActionButton}" Content="닫기" ToolTip="취소 (Esc 또는 X)"
                            Foreground="#FFFF8A8A"/>
                </StackPanel>
            </Border>

            <Border x:Name="ColorPalette" Visibility="Collapsed" Cursor="Arrow"
                    Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="6">
                <WrapPanel x:Name="ColorGrid" Width="152" Orientation="Horizontal"/>
            </Border>

        </Canvas>
    </Grid>
</Window>
