<Window x:Class="ScreenCapture.Views.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenCapture Pin"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        WindowStartupLocation="Manual"
        Background="Transparent"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Malgun Gothic">

    <Window.ContextMenu>
        <ContextMenu x:Name="Menu" FontFamily="Malgun Gothic" FontSize="12">
            <MenuItem x:Name="MenuCopy" Header="복사  (Ctrl+C)"/>
            <MenuItem x:Name="MenuSave" Header="PNG로 저장  (Ctrl+S)"/>
            <Separator/>
            <MenuItem x:Name="MenuActualSize" Header="원본 크기  (Ctrl+0)"/>
            <MenuItem x:Name="MenuOpaque" Header="불투명도 100%"/>
            <Separator/>
            <MenuItem x:Name="MenuClose" Header="닫기  (Esc)"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid x:Name="Root">
        <Border x:Name="Frame" BorderBrush="#FF4DA3FF" BorderThickness="1" Background="#FF202225">
            <Image x:Name="PinImage" Stretch="Fill"/>
        </Border>
        <Border x:Name="Badge" Visibility="Collapsed" Background="#D9101317" CornerRadius="3"
                Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5">
            <TextBlock x:Name="BadgeText" Foreground="White" FontSize="11"/>
        </Border>
    </Grid>
</Window>
