<Window x:Class="ScreenNote.Views.ZoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:LectureHelper.Views;assembly=LectureHelper.Shared"
        Title="ScreenNote 확대"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="False"
        WindowStartupLocation="Manual"
        Background="Black"
        Cursor="Cross"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Malgun Gothic">

    <Grid x:Name="Root" ClipToBounds="True">
        <Canvas x:Name="Viewport" Background="Black" HorizontalAlignment="Left" VerticalAlignment="Top"
                ClipToBounds="True">

            <Canvas x:Name="Stage" Canvas.Left="0" Canvas.Top="0">
                <Image x:Name="Shot" Canvas.Left="0" Canvas.Top="0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <v:AnnotationLayer x:Name="Layer" Canvas.Left="0" Canvas.Top="0"/>
            </Canvas>

            <!-- Lives outside Stage so typing stays crisp; the committed text is scaled back down. -->
            <TextBox x:Name="TextEditor" Visibility="Collapsed"
                     Background="#40000000" BorderBrush="#FF4DA3FF" BorderThickness="1"
                     Padding="2,0" MinWidth="40" AcceptsReturn="True" CaretBrush="White"
                     FontFamily="Malgun Gothic" FontWeight="Bold" Cursor="IBeam"/>

            <Border x:Name="HintBar" Style="{StaticResource HudPanel}" IsHitTestVisible="False"
                    Visibility="Collapsed">
                <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                    <Border x:Name="HintSwatch" Width="15" Height="15" CornerRadius="3"
                            BorderBrush="#FF9AA3AE" BorderThickness="1" Background="Red"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="HintStatus" Foreground="#FFF2F6FA" FontSize="13"
                               FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Foreground="#FFDDE3EA" FontSize="12" LineHeight="19">
                    <Run Text="마우스" FontWeight="Bold"/><Run Text=" 확대 위치 이동   "/>
                    <Run Text="휠" FontWeight="Bold"/><Run Text=" 배율   "/>
                    <Run Text="클릭" FontWeight="Bold"/><Run Text=" 그 자리에 고정하고 그리기 시작"/>
                    <LineBreak/>
                    <Run Text="드래그" FontWeight="Bold"/><Run Text=" 펜   "/>
                    <Run Text="Ctrl" FontWeight="Bold"/><Run Text=" 네모   "/>
                    <Run Text="Tab" FontWeight="Bold"/><Run Text=" 동그라미   "/>
                    <Run Text="Shift" FontWeight="Bold"/><Run Text=" 직선   "/>
                    <Run Text="Ctrl+Shift" FontWeight="Bold"/><Run Text=" 화살표   "/>
                    <Run Text="Ctrl+휠" FontWeight="Bold"/><Run Text=" 두께"/>
                    <LineBreak/>
                    <Run Text="R G B Y P O" FontWeight="Bold"/><Run Text=" 색상   "/>
                    <Run Text="H" FontWeight="Bold"/><Run Text=" 형광펜   "/>
                    <Run Text="M" FontWeight="Bold"/><Run Text=" 모자이크   "/>
                    <Run Text="Shift+M" FontWeight="Bold"/><Run Text=" 흐리게   "/>
                    <Run Text="N" FontWeight="Bold"/><Run Text=" 숫자   "/>
                    <Run Text="T" FontWeight="Bold"/><Run Text=" 텍스트"/>
                    <LineBreak/>
                    <Run Text="E" FontWeight="Bold"/><Run Text=" 전체 지우기   "/>
                    <Run Text="F1" FontWeight="Bold"/><Run Text=" 이 안내   "/>
                    <Run Text="Esc / X" FontWeight="Bold"/><Run Text=" 나가기"/>
                </TextBlock>
                </StackPanel>
            </Border>

        </Canvas>
    </Grid>
</Window>
