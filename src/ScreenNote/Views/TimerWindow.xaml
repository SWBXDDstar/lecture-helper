<Window x:Class="ScreenNote.Views.TimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="수업 타이머"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        FontFamily="Malgun Gothic">

    <Grid x:Name="Root">
        <Border x:Name="Panel" CornerRadius="10" Padding="14,10,14,12"
                Background="#F2202429" BorderBrush="#FF3A414B" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock x:Name="Caption" Text="수업 타이머" Foreground="#FF8B95A1" FontSize="11"
                               VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnFullscreen" Style="{StaticResource ToolButton}" Width="22" Height="22"
                                ToolTip="전체화면 (F11)">
                            <Path x:Name="FullscreenIcon"
                                  Data="M4,8 V4 H8 M14,4 H18 V8 M18,14 V18 H14 M8,18 H4 V14"
                                  Stroke="#FFB9C0C9" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Fill="Transparent"
                                  Stretch="Uniform" Width="12" Height="12"/>
                        </Button>
                        <Button x:Name="BtnClose" Style="{StaticResource ToolButton}" Width="22" Height="22"
                                ToolTip="닫기 (Esc)">
                            <Path Data="M6,6 L16,16 M16,6 L6,16" Stroke="#FFB9C0C9" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"
                                  Width="11" Height="11"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Centred so the fullscreen clock sits in the middle of the screen, not at the top. -->
                <StackPanel x:Name="Stack" Grid.Row="1" VerticalAlignment="Center">

                <TextBox x:Name="Display" Text="05:00"
                         Background="Transparent" BorderThickness="0" Foreground="#FFF2F5F8"
                         FontFamily="Consolas" FontSize="64" FontWeight="Bold"
                         TextAlignment="Center" CaretBrush="#FF4DA3FF" Margin="0,2,0,4"
                         MaxLength="6" IsUndoEnabled="False"/>

                <WrapPanel x:Name="Presets" HorizontalAlignment="Center" Margin="0,0,0,6">
                    <Button x:Name="BtnP1" Style="{StaticResource ActionButton}" Content="1분"/>
                    <Button x:Name="BtnP3" Style="{StaticResource ActionButton}" Content="3분"/>
                    <Button x:Name="BtnP5" Style="{StaticResource ActionButton}" Content="5분"/>
                    <Button x:Name="BtnP10" Style="{StaticResource ActionButton}" Content="10분"/>
                    <Button x:Name="BtnMinus" Style="{StaticResource ActionButton}" Content="−30초"/>
                    <Button x:Name="BtnPlus" Style="{StaticResource ActionButton}" Content="+30초"/>
                </WrapPanel>

                <StackPanel x:Name="Controls" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="BtnStart" Style="{StaticResource ActionButton}" Content="시작"
                            Height="32" MinWidth="92" FontSize="14" Foreground="White" Background="#FF1E7F4A"/>
                    <Button x:Name="BtnReset" Style="{StaticResource ActionButton}" Content="리셋"
                            Height="32" MinWidth="70" FontSize="14"/>
                </StackPanel>

                <TextBlock x:Name="Hint" Foreground="#FF6D7681" FontSize="10" Margin="0,7,0,0"
                           HorizontalAlignment="Center"
                           Text="드래그 이동 · 휠 크기조절 · Space 시작/정지 · 시간을 눌러 직접 입력"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
